# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Dependency directories
node_modules/
vendor/

# composer.lock is deliberately NOT ignored. It pins PHPCS and the WordPress Coding
# Standards, so every contributor and every CI run lints against the same rules —
# an unpinned install can fail a review on a sniff nobody else sees.

# Local environment files
.env
.env.*

# Logs
*.log
npm-debug.log*

# Source maps / Sass cache
*.map
.sass-cache/

# Test caches and reports. The suites themselves are committed; only their scratch output
# is ignored. Jest snapshots under tests/js/__snapshots__/ ARE committed — they are the
# record of what save() currently emits, and reviewing a change to one is the point.
.phpunit.cache/
.phpunit.result.cache
coverage/
playwright-report/
test-results/

# wp-env writes its per-developer overrides here. `.wp-env.json` IS committed — it pins the
# WordPress version and the ports the integration suite uses — but an override file is local
# to one machine and must not be.
.wp-env.override.json

# Editor / IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*~

# Note: build/ holds every compiled artifact — blocks, scripts and the stylesheet — and
# IS committed, so the theme can be deployed without running a build. Everything in it is
# generated from src/; never edit it by hand. Rebuild with `npm run build`.
