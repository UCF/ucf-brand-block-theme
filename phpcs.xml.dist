<?xml version="1.0"?>
<ruleset name="UCF Brand Block Theme">
	<description>WordPress coding standards for the UCF Brand Block Theme.</description>

	<!-- Scan the whole theme by default; pass a path to phpcs to narrow it. -->
	<file>.</file>

	<!-- Only lint PHP. -->
	<arg name="extensions" value="php"/>

	<!-- Show sniff codes and a progress bar, and run in parallel. -->
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<!-- Nothing generated, vendored, or non-PHP needs linting. -->
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/build/</exclude-pattern>
	<exclude-pattern>/assets/</exclude-pattern>

	<!-- Target the versions the theme supports (style.css: 6.5+, PHP 8.1+). -->
	<config name="minimum_supported_wp_version" value="6.5"/>

	<!-- The full WordPress standard: Core, Docs, and Extra. -->
	<rule ref="WordPress"/>

	<!-- Enforce this theme's text domain on all translation calls. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ucf-brand-block-theme"/>
			</property>
		</properties>
	</rule>

	<!-- Global functions/hooks must carry the theme prefix. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ucf_brand"/>
				<element value="UCF_Brand"/>
			</property>
		</properties>
	</rule>

	<!--
	The unit suite is PSR-4 autoloaded and follows PHPUnit's conventions, which are
	flatly incompatible with WordPress's file naming: PSR-4 requires the file to be
	named for the class (SectionNavTest.php), while WordPress wants
	class-sectionnavtest.php. Renaming would break autoloading, so the naming sniffs are
	scoped off for the test directory only — everything shipped still obeys them.
	-->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/php/</exclude-pattern>
		<exclude-pattern>/tests/integration/</exclude-pattern>
	</rule>

	<!--
	A PHPUnit method name is the assertion in words — test_the_front_page_is_excluded()
	needs no second sentence restating it. Descriptions are still written wherever a test
	pins behavior for a reason that is not obvious from its name.
	-->
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<exclude-pattern>/tests/php/</exclude-pattern>
		<exclude-pattern>/tests/integration/</exclude-pattern>
	</rule>

	<!--
	The suite's stand-ins for WP_Post and WP_Block must carry core's exact class names —
	that is the entire point, since the code under test type-checks against them — so the
	theme-prefix rule cannot apply. Same for ABSPATH in the bootstrap, which is core's
	constant and is what every include guards on.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedClassFound">
		<exclude-pattern>/tests/php/stubs/</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedConstantFound">
		<exclude-pattern>/tests/php/bootstrap\.php</exclude-pattern>
	</rule>

	<!--
	The stubs stand in for core functions and must carry core's exact names and
	signatures — a prefixed `ucf_brand_esc_html()` would stand in for nothing, and
	dropping the unused `$domain` parameter would stop the signature matching the
	function it replaces.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedFunctionFound">
		<exclude-pattern>/tests/php/stubs/</exclude-pattern>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<exclude-pattern>/tests/php/stubs/</exclude-pattern>
	</rule>

	<!--
	This sniff exists to stop a theme hand-printing a <script> tag instead of enqueueing
	it. UniversityHeaderTest builds those tags as fixtures — they are the *input* to the
	`script_loader_tag` filter under test — so it is reading strings the theme never emits.
	-->
	<rule ref="WordPress.WP.EnqueuedResources">
		<exclude-pattern>/tests/php/</exclude-pattern>
		<exclude-pattern>/tests/integration/</exclude-pattern>
	</rule>
</ruleset>
