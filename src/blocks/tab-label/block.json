{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ucf-brand/tab-label",
	"title": "Tab Label",
	"category": "design",
	"icon": "index-card",
	"parent": [ "ucf-brand/tab" ],
	"description": "The clickable label for a tab: a condensed H3 heading with an optional line of supporting copy under it.",
	"textdomain": "ucf-brand-block-theme",
	"keywords": [ "tab", "label", "heading" ],
	"attributes": {
		"heading": {
			"type": "string",
			"source": "html",
			"selector": ".ucf-tabs__heading",
			"default": ""
		},
		"description": {
			"type": "string",
			"source": "html",
			"selector": ".ucf-tabs__description",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"reusable": false,
		"inserter": false
	},
	"editorScript": "file:./index.js"
}
