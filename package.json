{
	"name": "ucf-brand-block-theme",
	"version": "1.0.0-alpha.6",
	"description": "Foundation-first block theme for UCF brand documentation.",
	"private": true,
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "npm run build:blocks && npm run build:css",
		"build:blocks": "wp-scripts build --webpack-src-dir=src/blocks --output-path=build",
		"build:css": "sass src/scss/main.scss build/css/main.css --style=compressed --no-source-map",
		"start": "wp-scripts start --webpack-src-dir=src/blocks --output-path=build",
		"watch": "sass --watch src/scss/main.scss build/css/main.css --style=expanded",
		"lint:js": "wp-scripts lint-js src/blocks src/js tests/js tests/a11y playwright.config.js",
		"lint:css": "wp-scripts lint-style \"src/scss/**/*.scss\"",
		"lint:version": "node tools/check-version.js",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "npm run test:php && npm run test:js",
		"test:php": "composer test",
		"test:js": "wp-scripts test-unit-js --config jest.config.js",
		"test:js:watch": "wp-scripts test-unit-js --config jest.config.js --watch",
		"test:integration": "node tools/integration-tests.js",
		"test:a11y": "node tools/a11y-tests.js",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:clean": "wp-env clean all",
		"env:seed": "wp-env run cli wp theme activate ucf-brand-block-theme && wp-env run cli wp eval-file wp-content/themes/ucf-brand-block-theme/tests/a11y/seed.php",
		"test:all": "npm run test && npm run test:integration && npm run test:a11y",
		"test:integration:only": "wp-env run tests-wordpress --env-cwd=wp-content/themes/ucf-brand-block-theme vendor/bin/phpunit -c phpunit-integration.xml.dist",
		"test:a11y:only": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@playwright/test": "^1.62.1",
		"@wordpress/block-editor": "^16.1.0",
		"@wordpress/block-library": "^10.3.0",
		"@wordpress/blocks": "^15.25.0",
		"@wordpress/components": "^38.0.0",
		"@wordpress/data": "^10.52.0",
		"@wordpress/env": "^10.39.0",
		"@wordpress/prettier-config": "^4.51.0",
		"@wordpress/scripts": "^30.0.0",
		"prettier": "npm:wp-prettier@3.0.3",
		"sass": "^1.100.0"
	},
	"overrides": {
		"typescript": "~5.3.3"
	}
}
