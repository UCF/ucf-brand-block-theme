{
	"name": "ucf-brand-block-theme",
	"version": "1.0.0-alpha.3",
	"description": "Foundation-first block theme for UCF brand documentation.",
	"private": true,
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "npm run build:blocks && npm run build:css",
		"build:blocks": "wp-scripts build --webpack-src-dir=src/blocks --output-path=build",
		"build:css": "sass src/scss/main.scss build/css/main.css --style=compressed --no-source-map",
		"start": "wp-scripts start --webpack-src-dir=src/blocks --output-path=build",
		"watch": "sass --watch src/scss/main.scss build/css/main.css --style=expanded",
		"lint:js": "wp-scripts lint-js src/blocks src/js",
		"lint:css": "wp-scripts lint-style \"src/scss/**/*.scss\"",
		"lint:version": "node tools/check-version.js",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@wordpress/prettier-config": "^4.51.0",
		"@wordpress/scripts": "^30.0.0",
		"sass": "^1.100.0"
	},
	"overrides": {
		"typescript": "~5.3.3"
	}
}
